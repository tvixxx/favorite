# Скопируйте в deploy/.env на сервере и заполните. В git этот файл не попадает.

# Домен, на который смотрит A-запись (без https://)
DOMAIN=favorite.example.ru
LETSENCRYPT_EMAIL=you@example.ru

# Где на хосте лежат данные Postgres и сертификаты
DATA_DIR=/srv/favorite/data

# База. Пароль сгенерируйте: openssl rand -base64 32
POSTGRES_USER=favorite
POSTGRES_PASSWORD=
POSTGRES_DB=favorites

# Секрет токенов: openssl rand -base64 48
# Один на оба токена — refresh подписывается тем же ключом
JWT_SECRET=

# Сроки жизни токенов. Обязательны: без них приложение не стартует
JWT_ACCESS_TOKEN_TTL=2h
JWT_REFRESH_TOKEN_TTL=7d

# Домен для refresh-куки. Оставьте пустым — тогда кука будет host-only,
# это верно для схемы «всё на одном домене».
# Строку не удаляйте: переменная должна существовать, пустая — можно
COOKIE_DOMAIN=

# --- бэкапы (см. backend/scripts/backup/README.md) ---
PG_CONTAINER=favorite-postgres
BACKUP_DIR=/srv/favorite/backups
# Копия вне сервера — обязательна. Ключ доступа выдайте ТОЛЬКО на запись.
S3_URI=
# Шифрование дампа: в нём email'ы, хеши паролей и переписка
GPG_RECIPIENT=
# Dead-man switch: пришлёт письмо, если бэкап не приходил (healthchecks.io)
HEALTHCHECK_URL=
