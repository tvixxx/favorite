generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN

  @@map("enum_user_role")
}

enum MediaPurpose {
  MOVIE_POSTER
  USER_AVATAR
  ACTOR_PHOTO
  FEEDBACK_SCREENSHOT

  @@map("enum_media_purpose")
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
  DELETING

  @@map("enum_media_status")
}

model MediaAsset {
  id           String       @id @default(uuid())
  ownerId      String?      @map("owner_id")
  purpose      MediaPurpose
  status       MediaStatus  @default(PROCESSING)
  mainKey      String       @default("") @map("main_key")
  thumbnailKey String       @default("") @map("thumbnail_key")
  mimeType     String       @default("image/webp") @map("mime_type")
  byteSize     Int          @map("byte_size")
  width        Int          @default(0)
  height       Int          @default(0)
  claimedAt    DateTime?    @map("claimed_at")
  expiresAt    DateTime?    @map("expires_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  owner        User?        @relation("media_owner", fields: [ownerId], references: [id], onDelete: SetNull)
  poster       MoviePoster? @relation("poster_media")
  avatar       User?        @relation("avatar_media")
  actorPhoto   Actor?       @relation("actor_media")
  feedback     Feedback?    @relation("feedback_media")

  @@index([ownerId, createdAt])
  @@index([status, expiresAt])
  @@map("media_assets")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  username  String? @unique
  timezone  String @default("UTC")
  quickAddEnabled Boolean @default(true) @map("quick_add_enabled")
  watchTonightEnabled Boolean @default(false) @map("watch_tonight_enabled")
  collectionFilesEnabled Boolean @default(false) @map("collection_files_enabled")
  notifyNewMessages Boolean @default(true) @map("notify_new_messages")
  notifyFriendRequests Boolean @default(true) @map("notify_friend_requests")
  notifyRecommendations Boolean @default(false) @map("notify_recommendations")
  role      UserRole @default(USER) @map("role")
  blockedAt DateTime? @map("blocked_at")
  blockedReason String? @map("blocked_reason")
  authVersion Int @default(0) @map("auth_version")
  tags      Genre?
  avatarUrl String? @map("avatar_url")
  avatarThumbnailUrl String? @map("avatar_thumbnail_url")
  avatarAssetId String? @unique @map("avatar_asset_id")
  avatarAsset MediaAsset? @relation("avatar_media", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  uploadedMedia MediaAsset[] @relation("media_owner")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userMovies           UserMovie[]    @relation("user_movies")
  lists                UserList[]     @relation("user_lists")
  reviews              Review[]       @relation("user_reviews")
  friendshipsRequested Friendship[]   @relation("friendship_requester")
  friendshipsReceived  Friendship[]   @relation("friendship_addressee")
  sentMessages         Message[]      @relation("sent_messages")
  receivedMessages     Message[]      @relation("received_messages")
  status               UserStatus?    @relation("user_status")
  notifications        Notification[] @relation("user_notifications")
  feedbacks            Feedback[]     @relation("user_feedbacks")
  createdMovies        Movie[]        @relation("created_movies")
  createdActors        Actor[]        @relation("created_actors")
  reviewReports ReviewReport[]
  usageEvents UsageEvent[]
  adminActions AdminAuditLog[]
  passwordReset PasswordReset?
  watchEntries WatchEntry[]

  @@map("users")
}

model PasswordReset {
  userId String @id @map("user_id")
  tokenHash String @unique @map("token_hash")
  authVersion Int @map("auth_version")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

enum ContentKind {
  GENERAL
  ANIME
  ANIMATION
  TV_SHOW

  @@map("enum_content_kind")
}

model Movie {
  id              String    @id @default(uuid())
  title           String
  titleNormalized String    @default("") @map("title_normalized")
  titleEn         String?  @map("title_en")
  originalTitle   String?  @map("original_title")
  titleAliases    String[] @default([]) @map("title_aliases")
  descriptionLanguage String @default("ru") @map("description_language")
  tvdbId          Int?     @map("tvdb_id")
  tvdbType        String?  @map("tvdb_type")
  description     String
  countryCodes    String[]  @default(["US"]) @map("country_codes")
  genres          Genre[]
  publishDate     DateTime? @map("publish_date")
  isSerial        Boolean   @default(false) @map("is_serial")
  contentKind     ContentKind? @map("content_kind")
  seasonCount     Int?      @map("season_count")
  episodeCount    Int?      @map("episode_count")
  posterId        String?   @unique @map("poster_id")
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  poster     MoviePoster?   @relation("movie_poster", fields: [posterId], references: [id])
  reviews    Review[]       @relation("movie_reviews")
  actors     Actor[]        @relation("movie_actors")
  userMovies UserMovie[]    @relation("movie_users")
  listItems  UserListItem[] @relation("movie_list_items")
  watchEntries WatchEntry[]
  createdBy  User?         @relation("created_movies", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([publishDate, title])
  @@index([titleNormalized])
  @@unique([tvdbType, tvdbId])
  @@map("movies")
}

model MoviePoster {
  id        String   @id @default(uuid())
  url       String   @default("")
  thumbnailUrl String? @map("thumbnail_url")
  assetId String? @unique @map("asset_id")
  asset MediaAsset? @relation("poster_media", fields: [assetId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  movie     Movie?   @relation("movie_poster")

  @@map("movie_posters")
}

model Review {
  id        String   @id @default(uuid())
  text      String
  isSpoiler Boolean @default(false) @map("is_spoiler")
  rate      Int      @default(0)
  hiddenAt DateTime? @map("hidden_at")
  moderationReason String? @map("moderation_reason")
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation("user_reviews", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  movie Movie @relation("movie_reviews", fields: [movieId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reports ReviewReport[]

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
  @@map("reviews")
}

model Actor {
  id        String   @id @default(uuid())
  tvdbId    Int?     @unique @map("tvdb_id")
  name      String
  imageUrl String? @map("image_url")
  imageThumbnailUrl String? @map("image_thumbnail_url")
  imageAssetId String? @unique @map("image_asset_id")
  imageAsset MediaAsset? @relation("actor_media", fields: [imageAssetId], references: [id], onDelete: SetNull)
  createdById String? @map("created_by_id")
  createdBy User? @relation("created_actors", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  movies    Movie[]  @relation("movie_actors")

  @@map("actors")
}

model UserMovie {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  movieId        String      @map("movie_id")
  isFavorite     Boolean     @default(false) @map("is_favorite")
  seeLater       Boolean     @default(false) @map("see_later")
  personalRate   Int?        @map("personal_rate")
  watchStatus    WatchStatus @default(NOT_STARTED) @map("watch_status")
  currentSeason  Int?        @map("current_season")
  currentEpisode Int?        @map("current_episode")
  addedAt        DateTime    @default(now()) @map("added_at")
  lastWatchedAt  DateTime?   @map("last_watched_at")
  startedAt      DateTime?   @map("started_at")
  completedAt    DateTime?   @map("completed_at")
  droppedAt      DateTime?   @map("dropped_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user  User  @relation("user_movies", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  movie Movie @relation("movie_users", fields: [movieId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
  @@index([isFavorite])
  @@index([seeLater])
  @@map("user_movies")
}

model WatchEntry {
  id String @id @default(uuid())
  userId String @map("user_id")
  movieId String? @map("movie_id")
  requestId String @map("request_id")
  requestHash String @map("request_hash")
  viewedOn DateTime @db.Date @map("viewed_on")
  scope String @default("TITLE")
  season Int?
  isRewatch Boolean @default(false) @map("is_rewatch")
  rating Int?
  note String @default("")
  revision Int @default(1)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie? @relation(fields: [movieId], references: [id], onDelete: Restrict)

  @@unique([userId, requestId])
  @@index([userId, deletedAt, viewedOn, createdAt, id])
  @@index([userId, movieId, deletedAt, viewedOn])
  @@index([movieId])
  @@map("watch_entries")
}

model UserList {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  name           String
  nameNormalized String   @map("name_normalized")
  description    String?
  color          String?  @default("#FF0032")
  labels         String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user  User           @relation("user_lists", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items UserListItem[] @relation("list_items")

  @@unique([userId, nameNormalized])
  @@index([userId])
  @@map("user_lists")
}

model UserListItem {
  id        String   @id @default(uuid())
  listId    String   @map("list_id")
  movieId   String   @map("movie_id")
  addedAt   DateTime @default(now()) @map("added_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  list  UserList @relation("list_items", fields: [listId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  movie Movie    @relation("movie_list_items", fields: [movieId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([listId, movieId])
  @@index([listId])
  @@index([movieId])
  @@map("user_list_items")
}

enum WatchStatus {
  NOT_STARTED
  WATCHING
  COMPLETED
  DROPPED

  @@map("enum_watch_status")
}

enum Genre {
  ACTION
  DRAMA
  COMEDY
  DETECTIVE
  FAMILY
  FANTASY
  HORROR
  MUSICAL
  ROMANCE
  THRILLER
  WAR
  WESTERN
  DOCUMENTARY
  Sci_fi      @map("Sci-fi")
  ADVENTURE
  AWARDS_SHOW
  CHILDREN
  CRIME
  FOOD
  GAME_SHOW
  HISTORY
  HOME_AND_GARDEN
  INDIE
  MARTIAL_ARTS
  MINI_SERIES
  NEWS
  PODCAST
  REALITY
  SOAP
  SPORT
  SUSPENSE
  TALK_SHOW
  TRAVEL

  @@map("enum_genre")
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String           @map("requester_id")
  addresseeId String           @map("addressee_id")
  status      FriendshipStatus @default(PENDING)
  type        FriendshipType   @default(FRIEND_REQUEST)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester User @relation("friendship_requester", fields: [requesterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  addressee User @relation("friendship_addressee", fields: [addresseeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requesterId, addresseeId, type])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
  @@map("friendships")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED

  @@map("enum_friendship_status")
}

enum FriendshipType {
  FRIEND_REQUEST
  SUBSCRIPTION

  @@map("enum_friendship_type")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  sender   User @relation("sent_messages", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  receiver User @relation("received_messages", fields: [receiverId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([isRead])
  @@map("messages")
}

model UserStatus {
  userId     String   @id @map("user_id")
  isOnline   Boolean  @default(false) @map("is_online")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  socketId   String?  @map("socket_id")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation("user_status", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_statuses")
}

enum NotificationType {
  CHAT_MESSAGE
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FRIEND_REJECTED

  @@map("enum_notification_type")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  payload   Json
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation("user_notifications", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Обращения из формы «Обратная связь» (/feedback).
/// Читается администратором через GET /feedback.
model Feedback {
  id        String         @id @default(uuid())
  /// null — если автора удалили: обращение остаётся
  userId    String?        @map("user_id")
  type      FeedbackType
  message   String
  /// Необязательная почта для ответа (может отличаться от почты аккаунта)
  email     String?
  /// Автоконтекст: откуда писал и в каком окружении
  pageUrl   String?        @map("page_url")
  userAgent String?        @map("user_agent")
  viewport  String?
  screenshotAssetId String? @unique @map("screenshot_asset_id")
  screenshot MediaAsset? @relation("feedback_media", fields: [screenshotAssetId], references: [id], onDelete: SetNull)
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User? @relation("user_feedbacks", fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /// Выборка в админке: свежие в рамках статуса
  @@index([status, createdAt])
  @@index([userId])
  @@map("feedback")
}

enum FeedbackType {
  IDEA
  BUG
  OTHER

  @@map("enum_feedback_type")
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  DONE

  @@map("enum_feedback_status")
}

model ReviewReport {
  id String @id @default(uuid())
  reviewId String @map("review_id")
  reporterId String @map("reporter_id")
  reason String
  comment String?
  resolvedAt DateTime? @map("resolved_at")
  createdAt DateTime @default(now()) @map("created_at")
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId])
  @@index([resolvedAt, createdAt])
  @@map("review_reports")
}

model AdminAuditLog {
  id String @id @default(uuid())
  actorId String? @map("actor_id")
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String
  targetId String @map("target_id")
  reason String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([targetId, createdAt])
  @@map("admin_audit_log")
}

model UsageEvent {
  id String @id
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature String
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([feature, occurredAt])
  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@map("usage_events")
}
